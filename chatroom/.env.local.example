# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only Supabase key — required for offline DM email lookups
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend — required for offline DM email delivery
RESEND_API_KEY=your_resend_api_key
DM_NOTIFY_FROM=CHATROOM.exe <notify@yourdomain.com>

# Where notification emails should send people back
CHATROOM_PUBLIC_URL=https://chat.ivonnealdaz.com

